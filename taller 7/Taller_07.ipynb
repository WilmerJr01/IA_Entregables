      "source": [
        "import ipywidgets as widgets\n",
        "from IPython.display import display\n",
        "from functools import lru_cache\n",
        "\n",
        "try:\n",
        "    from google.colab import output as salida_colab\n",
        "    salida_colab.enable_custom_widget_manager()\n",
        "except ImportError:\n",
        "    pass\n",
        "\n",
        "@lru_cache(maxsize=128)\n",
        "def modelos_interactivos(k, radio):\n",
        "    knn = clone(modelo_knn_base).set_params(\n",
        "        clasificador__n_neighbors=int(k)).fit(X_train_original, y_train)\n",
        "    rnn = clone(modelo_rnn_base).set_params(\n",
        "        clasificador__radius=float(radio)).fit(X_train_original, y_train)\n",
        "    return knn, rnn\n",
        "\n",
        "def mostrar_prediccion(indice, k, radio):\n",
        "    knn, rnn = modelos_interactivos(int(k), round(float(radio), 2))\n",
        "    muestra = X_test_original[indice:indice + 1]\n",
        "    pred_knn_interactivo = int(knn.predict(muestra)[0])\n",
        "    pred_rnn_interactivo = int(rnn.predict(muestra)[0])\n",
        "    prob_knn = knn.predict_proba(muestra)[0]\n",
        "    prob_rnn = rnn.predict_proba(muestra)[0]\n",
        "\n",
        "    fig, axes = plt.subplots(1, 3, figsize=(14, 4))\n",
        "    axes[0].imshow(imagenes_test[indice], cmap='gray_r', interpolation='nearest')\n",
        "    axes[0].set_title(f'Imagen de prueba\\nReal: {y_test[indice]}')\n",
        "    axes[0].set_xticks([])\n",
        "    axes[0].set_yticks([])\n",
        "\n",
        "    axes[1].bar(clases, prob_knn, color='#4472c4')\n",
        "    axes[1].set_title(f'KNN: predicción {pred_knn_interactivo}\\nK={k}')\n",
        "    axes[1].set_xlabel('Dígito')\n",
        "    axes[1].set_ylabel('Probabilidad')\n",
        "    axes[1].set_xticks(clases)\n",
        "    axes[1].set_ylim(0, 1.05)\n",
        "\n",
        "    axes[2].bar(clases, prob_rnn, color='#ed7d31')\n",
        "    axes[2].set_title(f'RNN: predicción {pred_rnn_interactivo}\\nR={radio:.2f}')\n",
        "    axes[2].set_xlabel('Dígito')\n",
        "    axes[2].set_ylabel('Probabilidad')\n",
        "    axes[2].set_xticks(clases)\n",
        "    axes[2].set_ylim(0, 1.05)\n",
        "\n",
        "    fig.tight_layout()\n",
        "    plt.show()\n",
        "    plt.close(fig)\n",
        "\n",
        "barra_indice = widgets.IntSlider(\n",
        "    value=0, min=0, max=len(y_test) - 1, step=1,\n",
        "    description='Muestra:', continuous_update=False,\n",
        "    layout=widgets.Layout(width='650px'))\n",
        "barra_k = widgets.IntSlider(\n",
        "    value=mejor_k, min=int(valores_k.min()), max=int(valores_k.max()), step=2,\n",
        "    description='K:', continuous_update=False,\n",
        "    layout=widgets.Layout(width='650px'))\n",
        "barra_r = widgets.FloatSlider(\n",
        "    value=mejor_r, min=float(valores_r.min()), max=float(valores_r.max()),\n",
        "    step=0.5, description='R:', readout_format='.1f',\n",
        "    continuous_update=False, layout=widgets.Layout(width='650px'))\n",
        "\n",
        "salida_interactiva = widgets.interactive_output(\n",
        "    mostrar_prediccion,\n",
        "    {'indice': barra_indice, 'k': barra_k, 'radio': barra_r})\n",
        "display(widgets.VBox([barra_indice, barra_k, barra_r, salida_interactiva]))"
