      "source": [
        "def graficar_resultados(valores, resultados, titulo, nombre_parametro):\n",
        "    fig, axes = plt.subplots(2, 4, figsize=(17, 8), sharex=True)\n",
        "    for ax, nombre in zip(axes.ravel(), metricas_principales):\n",
        "        media = resultados[nombre].mean(axis=1)\n",
        "        desviacion = resultados[nombre].std(axis=1, ddof=1)\n",
        "        minimizar = nombre in ['Log loss', 'Brier multiclase']\n",
        "        mejor = np.argmin(media) if minimizar else np.argmax(media)\n",
        "\n",
        "        ax.plot(valores, media, 'o-', markersize=3)\n",
        "        ax.fill_between(valores, media - desviacion, media + desviacion,\n",
        "                        alpha=0.18, label='Media ± 1 desviación')\n",
        "        ax.scatter(valores[mejor], media[mejor], color='red', zorder=5,\n",
        "                   label=f'Mejor: {nombre_parametro}={valores[mejor]}')\n",
        "        ax.set_title(nombre + (' (menor)' if minimizar else ' (mayor)'))\n",
        "        ax.set_xlabel(nombre_parametro)\n",
        "        ax.set_ylabel(nombre)\n",
        "        ax.grid(alpha=0.25)\n",
        "        ax.legend(fontsize=8)\n",
        "\n",
        "    axes.ravel()[-1].axis('off')\n",
        "    fig.suptitle(titulo, fontsize=15)\n",
        "    fig.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "graficar_resultados(\n",
        "    valores_k, resultados_knn,\n",
        "    'KNN: métricas promedio en validación cruzada de 4 folds', 'K')"
      ]
    },
