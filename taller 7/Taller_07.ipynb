      "source": [
        "valores_k = np.arange(1, 32, 2)\n",
        "resultados_knn = {\n",
        "    nombre: np.zeros((len(valores_k), cv.get_n_splits()))\n",
        "    for nombre in metricas_principales\n",
        "}\n",
        "\n",
        "for fold, (indices_it, indices_iv) in enumerate(\n",
        "        cv.split(X_train_original, y_train), start=0):\n",
        "    X_it = X_train_original[indices_it]\n",
        "    X_iv = X_train_original[indices_iv]\n",
        "    y_it = y_train[indices_it]\n",
        "    y_iv = y_train[indices_iv]\n",
        "\n",
        "    for j, k in enumerate(valores_k):\n",
        "        modelo = clone(modelo_knn_base).set_params(\n",
        "            clasificador__n_neighbors=int(k))\n",
        "        modelo.fit(X_it, y_it)\n",
        "        predicho = modelo.predict(X_iv)\n",
        "        probabilidades = modelo.predict_proba(X_iv)\n",
        "        valores = calcular_metricas(y_iv, predicho, probabilidades, clases)\n",
        "\n",
        "        for nombre in metricas_principales:\n",
        "            resultados_knn[nombre][j, fold] = valores[nombre]\n",
        "\n",
        "resumen_knn = pd.DataFrame({\n",
        "    'K': valores_k,\n",
        "    **{nombre: resultados_knn[nombre].mean(axis=1)\n",
        "       for nombre in metricas_principales}\n",
        "})\n",
        "resumen_knn.round(4)"
      ]
    },
