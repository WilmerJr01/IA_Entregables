      "source": [
        "valores_r = np.round(np.arange(2.0, 12.01, 0.5), 2)\n",
        "metricas_rnn = metricas_principales + ['Cobertura', 'Vecinos medios']\n",
        "resultados_rnn = {\n",
        "    nombre: np.zeros((len(valores_r), cv.get_n_splits()))\n",
        "    for nombre in metricas_rnn\n",
        "}\n",
        "\n",
        "for fold, (indices_it, indices_iv) in enumerate(\n",
        "        cv.split(X_train_original, y_train), start=0):\n",
        "    X_it = X_train_original[indices_it]\n",
        "    X_iv = X_train_original[indices_iv]\n",
        "    y_it = y_train[indices_it]\n",
        "    y_iv = y_train[indices_iv]\n",
        "\n",
        "    for j, radio in enumerate(valores_r):\n",
        "        modelo = clone(modelo_rnn_base).set_params(\n",
        "            clasificador__radius=float(radio))\n",
        "        modelo.fit(X_it, y_it)\n",
        "        predicho = modelo.predict(X_iv)\n",
        "        probabilidades = modelo.predict_proba(X_iv)\n",
        "        valores = calcular_metricas(y_iv, predicho, probabilidades, clases)\n",
        "\n",
        "        escalador_fold = modelo.named_steps['escalador']\n",
        "        clasificador_fold = modelo.named_steps['clasificador']\n",
        "        X_iv_escalado = escalador_fold.transform(X_iv)\n",
        "        vecinos = clasificador_fold.radius_neighbors(\n",
        "            X_iv_escalado, return_distance=False)\n",
        "        cantidad_vecinos = np.array([len(grupo) for grupo in vecinos])\n",
        "        valores['Cobertura'] = np.mean(cantidad_vecinos > 0)\n",
        "        valores['Vecinos medios'] = cantidad_vecinos.mean()\n",
        "\n",
        "        for nombre in metricas_rnn:\n",
        "            resultados_rnn[nombre][j, fold] = valores[nombre]\n",
        "\n",
        "resumen_rnn = pd.DataFrame({\n",
        "    'R': valores_r,\n",
        "    **{nombre: resultados_rnn[nombre].mean(axis=1)\n",
        "       for nombre in metricas_rnn}\n",
        "})\n",
        "resumen_rnn.round(4)"
      ]
    },
