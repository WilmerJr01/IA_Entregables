          ]
        }
      ],
      "source": [
        "indices = np.arange(len(y))\n",
        "indices_train, indices_test = train_test_split(\n",
        "    indices, test_size=0.20, random_state=SEED, stratify=y)\n",
        "\n",
        "X_train_original = X[indices_train]\n",
        "X_test_original = X[indices_test]\n",
        "y_train = y[indices_train]\n",
        "y_test = y[indices_test]\n",
        "imagenes_test = imagenes[indices_test]\n",
        "\n",
        "print(f'Entrenamiento: {len(y_train)} muestras ({len(y_train) / len(y):.0%})')\n",
        "print(f'Prueba: {len(y_test)} muestras ({len(y_test) / len(y):.0%})')\n",
        "print('Clases en entrenamiento:', np.unique(y_train))\n",
        "print('Clases en prueba:', np.unique(y_test))"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "T8gRKPSIYtkn",
      "metadata": {
        "id": "T8gRKPSIYtkn"
      },
      "source": [
        "## 3. Clasificadores base\n",
        "\n",
        "KNN usa votación uniforme entre los vecinos. RNN usa pesos inversamente proporcionales a la distancia. En RNN, `outlier_label='most_frequent'` define una regla de respaldo para una consulta sin vecinos dentro del radio: se le asigna la clase más frecuente del entrenamiento. Los radios se expresan en el espacio estandarizado de las 64 características."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "-va9SNBrYtko",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-09-25T02:11:28.968808Z",
          "iopub.status.busy": "2026-09-25T02:11:28.968308Z",
          "iopub.status.idle": "2026-09-25T02:11:28.972238Z",
          "shell.execute_reply": "2026-09-25T02:11:28.971300Z"
        },
        "id": "-va9SNBrYtko"
      },
      "outputs": [],
      "source": [
        "modelo_knn_base = Pipeline([\n",
        "    ('escalador', StandardScaler()),\n",
        "    ('clasificador', KNeighborsClassifier(\n",
        "        n_neighbors=5, weights='uniform', metric='euclidean', n_jobs=-1))\n",
        "])\n",
        "\n",
        "modelo_rnn_base = Pipeline([\n",
        "    ('escalador', StandardScaler()),\n",
        "    ('clasificador', RadiusNeighborsClassifier(\n",
        "        radius=6.0, weights='distance', metric='euclidean',\n",
        "        outlier_label='most_frequent', n_jobs=-1))\n",
        "])\n",
        "\n",
        "cv = StratifiedKFold(n_splits=4, shuffle=True, random_state=SEED)\n",
        "metricas_principales = [\n",
        "    'Accuracy', 'Balanced accuracy', 'F1 macro',\n",
        "    'ROC-AUC macro OvR', 'Kappa', 'Log loss', 'Brier multiclase'\n",
        "]"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "ZCuSXzSLYtkp",
      "metadata": {
        "id": "ZCuSXzSLYtkp"
      },
      "source": [
        "## 4. Función para calcular métricas\n",
        "\n",
        "Además de accuracy y F1 macro se incluyen balanced accuracy, ROC-AUC macro OvR, Kappa, Log loss y Brier multiclase. En Log loss y Brier un valor menor es mejor; en las demás métricas un valor mayor es mejor."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "id": "V2lQJzhcYtkp",
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-09-25T02:11:28.973775Z",
          "iopub.status.busy": "2026-09-25T02:11:28.973295Z",
          "iopub.status.idle": "2026-09-25T02:11:28.977086Z",
          "shell.execute_reply": "2026-09-25T02:11:28.976374Z"
        },
        "id": "V2lQJzhcYtkp"
      },
      "outputs": [],
      "source": [
        "def calcular_metricas(y_real, y_predicho, probabilidades, clases):\n",
        "    reales_onehot = label_binarize(y_real, classes=clases)\n",
        "    brier = np.mean(np.sum((probabilidades - reales_onehot) ** 2, axis=1))\n",
        "\n",
        "    return {\n",
        "        'Accuracy': accuracy_score(y_real, y_predicho),\n",
        "        'Balanced accuracy': balanced_accuracy_score(y_real, y_predicho),\n",
        "        'F1 macro': f1_score(y_real, y_predicho, average='macro', zero_division=0),\n",
        "        'ROC-AUC macro OvR': roc_auc_score(\n",
        "            y_real, probabilidades, multi_class='ovr',\n",
        "            average='macro', labels=clases),\n",
        "        'Kappa': cohen_kappa_score(y_real, y_predicho),\n",
        "        'Log loss': log_loss(y_real, probabilidades, labels=clases),\n",
        "        'Brier multiclase': brier\n",
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "MWZ2TU6iYtkq",
      "metadata": {
        "id": "MWZ2TU6iYtkq"
      },
      "source": [
