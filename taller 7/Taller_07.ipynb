          "output_type": "display_data"
        }
      ],
      "source": [
        "escalador_final = modelo_rnn_final.named_steps['escalador']\n",
        "clasificador_final = modelo_rnn_final.named_steps['clasificador']\n",
        "vecinos_test = clasificador_final.radius_neighbors(\n",
        "    escalador_final.transform(X_test_original), return_distance=False)\n",
        "sin_vecinos = np.array([len(grupo) == 0 for grupo in vecinos_test])\n",
        "\n",
        "clase_mas_frecuente = int(np.bincount(y_train).argmax())\n",
        "falsos_3 = (pred_rnn == clase_mas_frecuente) & (y_test != clase_mas_frecuente)\n",
        "\n",
        "print(f'Clase más frecuente en entrenamiento: {clase_mas_frecuente} '\n",
        "      f'({np.bincount(y_train).max()} muestras)')\n",
        "print(f'Muestras de prueba sin vecinos dentro de R={mejor_r:.1f}: '\n",
        "      f'{sin_vecinos.sum()} de {len(y_test)} ({sin_vecinos.mean():.1%})')\n",
        "print(f'Clase asignada a esas muestras: {np.unique(pred_rnn[sin_vecinos])}')\n",
        "print(f'Clase real de esas muestras:     {y_test[sin_vecinos]}')\n",
        "print(f'Falsos positivos de la clase {clase_mas_frecuente}: {falsos_3.sum()}, '\n",
        "      f'de ellos sin vecinos: {(falsos_3 & sin_vecinos).sum()}')\n",
        "\n",
        "acc_con_vecinos = accuracy_score(y_test[~sin_vecinos], pred_rnn[~sin_vecinos])\n",
        "print(f'Accuracy de RNN solo en muestras con vecinos: {acc_con_vecinos:.4f}')\n",
        "\n",
        "fig, axes = plt.subplots(1, sin_vecinos.sum(), figsize=(1.2 * sin_vecinos.sum(), 2))\n",
        "for ax, i in zip(np.atleast_1d(axes), np.flatnonzero(sin_vecinos)):\n",
        "    ax.imshow(imagenes_test[i], cmap='gray_r', interpolation='nearest')\n",
        "    ax.set_title(f'Real {y_test[i]}', fontsize=8)\n",
        "    ax.set_xticks([]); ax.set_yticks([])\n",
        "fig.suptitle('Muestras de prueba sin vecinos dentro del radio (RNN las asigna a la clase 3)', fontsize=10)\n",
        "fig.tight_layout()\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "f27788cc",
      "metadata": {
        "id": "f27788cc"
      },
      "source": [
        "Casi todos los falsos 3 de RNN provienen de muestras sin vecinos, no de vecindarios mal formados. Esto también explica el Log loss alto de RNN: a esas muestras se les asigna probabilidad 1 a una clase equivocada, y Log loss castiga con fuerza las predicciones seguras e incorrectas. Si se excluyen esas 14 muestras, la accuracy de RNN sube a 0.988 sobre las 346 restantes. Esa cifra no es directamente comparable con la de KNN, porque se calcula sobre un subconjunto más fácil, pero muestra que el problema de RNN es la regla de respaldo y no la calidad de sus vecindarios. KNN no tiene este problema porque siempre encuentra `K` vecinos, sin importar qué tan lejos estén."
      ]
    },
